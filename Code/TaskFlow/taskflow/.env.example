# Copy to .env and fill in. .env is git-ignored; this file must never contain a real secret.

# ---------- app ----------
TASKFLOW_ENV=local
TASKFLOW_TENANT_ID=taskflow-demo
# Bearer token required by every mutating API endpoint. Generate your own.
TASKFLOW_API_TOKEN=
# Where the Gmail poller/push listener post inbound messages. They never open the
# vector store themselves — only the API does — so this must point at a running one.
TASKFLOW_API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/taskflow.db

# ---------- retrieval (embedded — no server) ----------
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=taskflow_kb

# ---------- llm ----------
# cloud_first = OpenRouter -> Claude -> Ollama
# local_only  = Ollama only. Use this to prove the system runs with no network at all.
TASKFLOW_LLM_MODE=cloud_first
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Model ids live in config/providers.yaml, never here and never in code.

# ---------- gmail (inbound: IMAP poll or push · outbound: SMTP delivery) ----------
# poll = IMAP, works with zero extra setup. push = Watch + Pub/Sub, needs the GCP
# setup in docs/14_GMAIL_PUSH_SETUP.md. `make poller` / `make poller-push` run each.
GMAIL_INBOUND_MODE=poll
# GMAIL_APP_PASSWORD is a Google App Password, not your account password. Used by
# IMAP poll and by outbound SMTP delivery either way.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_POLL_SECONDS=30
GMAIL_LABEL=INBOX
OPS_EMAIL=
# push mode only — an OAuth client from Google Cloud Console (docs/14 step 2) and
# the token scripts/gmail_watch_setup.py writes after you consent (docs/14 step 5).
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json
GCP_PROJECT_ID=
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=

# ---------- alerts ----------
# Each channel is independent; leave any of them blank to disable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
